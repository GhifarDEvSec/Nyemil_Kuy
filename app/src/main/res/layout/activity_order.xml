<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavOrder"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_large">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alamat pengiriman (Order)"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alamat"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Lengkap"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etOrderName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_input_light"
                android:hint="Nama Lengkap"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_dark"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alamat Lengkap"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etOrderAddress"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_input_light"
                android:hint="Alamat lengkap pengiriman"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_dark"
                android:padding="16dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patokan atau detail lengkap / Catatan"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etOrderNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_input_light"
                android:hint="Patokan atau detail lengkap"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_dark"
                android:padding="16dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btnOrderSubmit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_button_green"
                android:text="Order dan Kirim"
                android:textAllCaps="false"
                android:textColor="@color/card_white"
                android:textSize="@dimen/text_price"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavOrder"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/card_white"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnOrderNavHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Home"
            android:textColor="@color/text_muted"
            android:background="@android:color/transparent"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnOrderNavOrder"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Order"
            android:textColor="@color/primary_green"
            android:textStyle="bold"
            android:background="@drawable/bg_nav_active"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnOrderNavProfile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Profile"
            android:textColor="@color/text_muted"
            android:background="@android:color/transparent"
            app:backgroundTint="@null" />
    </LinearLayout>
</RelativeLayout>